var newline = 10
var msg = "LibreCompiler v1.0.0"
var msg_len = 20
var msg_comp = "Compiling: "
var msg_comp_len = 11

mov(rax, 1)
mov(rdi, 1)
mov(rsi, [msg])
mov(rdx, [msg_len])
exec()

mov(rax, 1)
mov(rdi, 1)
mov(rsi, [newline])
mov(rdx, 1)
exec()

mov(rax, 1)
mov(rdi, 1)
mov(rsi, [msg_comp])
mov(rdx, [msg_comp_len])
exec()

mov(rdx, 3)
mov([msg_len], rdx)
mov(rax, 1)
mov(rdi, 1)
mov(rsi, [msg])
mov(rdx, [msg_len])
exec()

exit(0)


