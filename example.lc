/ VARIAVEIS
var newline[1] = 10
var msg[20] = "LibreCompiler v1.0.0"
var buffer[1000]

/ LibreCompiler
mov(rax, 1)
mov(rdi, 1)
mov(rsi, &msg)
mov(rdx, 20)
exec()

/ NEWLINE
mov(rax, 1)
mov(rdi, 1)
mov(rsi, &newline)
mov(rdx, 1)
exec()

args(2) / Moves the second arg in rax
mov(rsi, rax)

mov(rbx, 0)

call loop

func loop:
	mov(rax, 1)
	mov(rdi, 1)
	mov(rsi, &msg)
	mov(rdx, 20)
	exec()
	
	mov(rax, 1)
	mov(rdi, 1)
	mov(rsi, &newline)
	mov(rdx, 1)
	exec()
	
	call loop
end

exit(0)
